<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Produk - Kasap.id</title>
    <!-- Hubungkan Ikon Keren dari FontAwesome -->
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #f5f5f5;
        }
        /* Kontainer Utama Produk */
        .container-produk {
            max-width: 500px;
            margin: 0 auto;
            background-color: #ffffff;
            min-height: 100vh;
            padding-bottom: 80px; /* Jarak agar konten tidak tertutup tombol bawah */
        }
        .foto-produk {
            width: 100%;
            aspect-ratio: 1/1;
            background-color: #eaeaea;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #888;
            font-size: 18px;
        }
        .info-harga {
            padding: 15px;
        }
        .harga {
            color: #ff4500;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .nama-produk {
            font-size: 16px;
            color: #333;
            line-height: 1.4;
        }

        /* BAR DETAIL BOTTOM ACTIONS (Mirip Shopee) */
        .bottom-action-bar {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 500px;
            height: 60px;
            background-color: #ffffff;
            display: flex;
            align-items: center;
            border-top: 1px solid #e0e0e0;
            z-index: 1000;
        }
        /* Tombol Tipe Ikon (Chat & Keranjang) */
        .btn-action-icon {
            width: 15%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ff4500;
            text-decoration: none;
            background: none;
            border: none;
            border-right: 1px solid #f0f0f0;
            cursor: pointer;
            font-size: 18px;
        }
        .btn-action-icon span {
            font-size: 10px;
            color: #666;
            margin-top: 2px;
        }
        /* Tombol Utama Beli Sekarang */
        .btn-action-buy {
            width: 70%;
            height: 100%;
            background-color: #ff4500;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            font-size: 16px;
            text-decoration: none;
            border: none;
            cursor: pointer;
        }
        .btn-action-buy:hover {
            background-color: #e03d00;
        }
    </style>
</head>
<body>

    <div class="container-produk">
        <!-- Area Foto Utama -->
        <div class="foto-produk">
            <i class="fa-regular fa-image fa-2x"></i> &nbsp; Foto Produk
        </div>

        <!-- Info Detail Teks -->
        <div class="info-harga">
            <div class="harga">Rp 124.950</div>
            <h1 class="nama-produk">Nama Produk Contoh Kasap.id - Kualitas Premium Desain Tradisional Siap Pakai</h1>
        </div>
    </div>

    <!-- STICKY ACTION BAR BAWAH -->
    <div class="bottom-action-bar">
        <!-- 1. Sambungan ke Chat WhatsApp -->
        <a href="https://wa.me" class="btn-action-icon" target="_blank">
            <i class="fa-regular fa-comments"></i>
            <span>Chat</span>
        </a>
        
        <!-- 2. Sambungan ke Fungsi Masuk Keranjang -->
        <button class="btn-action-icon" onclick="tambahKeKeranjang()">
            <i class="fa-solid fa-cart-plus"></i>
            <span>Keranjang</span>
        </button>
        
        <!-- 3. Sambungan Langsung ke Halaman Checkout -->
        <a href="/checkout" class="btn-action-buy">
            Beli Sekarang
        </a>
    </div>

    <script>
        function tambahKeKeranjang() {
            alert("Produk berhasil dimasukkan ke keranjang belanja Kasap.id!");
            // Di sini nanti kamu bisa sisipkan logika penambahan angka notifikasi keranjang hijaumu
        }
    </script>
</body>
</html>
