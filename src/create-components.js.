const fs = require('fs');
const path = require('path');

const components = [
    'akunsaya',
    'alamat',
    'bankewallet',
    'belumdibayar',
    'beranda',
    'berinilai',
    'chat',
    'chekout',
    'dikemas',
    'dikirim',
    'email',
    'hubungics',
    'keranjang',
    'laporan',
    'live',
    'masukkeranjang',
    'tarikdana',
    'produk'
];

const srcDir = path.join(__dirname, 'src');

// Pastikan folder src ada
if (!fs.existsSync(srcDir)){
    fs.mkdirSync(srcDir, { recursive: true });
}

components.forEach(name => {
    const filePath = path.join(srcDir, `${name}.jsx`);
    const templateContent = `import React from 'react';\n\nexport default function ${name.charAt(0).toUpperCase() + name.slice(1)}() {\n    return (\n        <div>\n            <h1>Halaman ${name}</h1>\n        </div>\n    );\n}\n`;

    // Buat file hanya jika belum ada agar kode yang sudah ditulis tidak tertimpa
    if (!fs.existsSync(filePath)) {
        fs.writeFileSync(filePath, templateContent, 'utf8');
        console.log(`Berhasil membuat: ${name}.jsx`);
    } else {
        console.log(`File sudah ada (dilewati): ${name}.jsx`);
    }
});

console.log('Semua komponen selesai diproses!');